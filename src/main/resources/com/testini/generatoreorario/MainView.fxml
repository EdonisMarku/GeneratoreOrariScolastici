<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #2b2b2b;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.testini.generatoreorario.GUI.MainController">

    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="titoloPrincipale" alignment="CENTER" contentDisplay="CENTER" prefHeight="48.0" prefWidth="499.0" text="Generatore Orari Scolastici" textAlignment="CENTER" textFill="RED">
        <font>
            <Font name="System Bold Italic" size="39.0" />
        </font></Label>
    <HBox alignment="CENTER_LEFT" prefHeight="24.0" prefWidth="512.0">
        <Button onAction="#onOpenFilePicker" prefHeight="26.0" prefWidth="145.0" styleClass="sceglifile-button" text="Seleziona file" />

        <Separator opacity="0.0" prefHeight="26.0" prefWidth="15.0" />

        <Label fx:id="fileName" prefHeight="17.0" prefWidth="232.0" text="Nome del file selezionato" textFill="#f2f2f2" />

        <Region HBox.hgrow="ALWAYS" />

        <Button onAction="#finestraOrariClassi" text="Orari Classi" prefHeight="26.0" prefWidth="146.0" styleClass="generaorarioclassi-button" />

        <Separator opacity="0.0" prefWidth="20" />

        <Button onAction="#finestraOrariDocenti" prefHeight="26.0" prefWidth="146.0" styleClass="generaorariodocenti-button" text="Orari Docenti" />

    </HBox>

    <TableView fx:id="tabellaIniziale" editable="false" prefHeight="400.0" prefWidth="600.0">

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>

        <columns>
            <TableColumn reorderable="false" text="Docente" />
            <TableColumn reorderable="false" text="Anno" />
            <TableColumn reorderable="false" text="Sezione" />
            <TableColumn reorderable="false" text="Indirizzo" />
            <TableColumn reorderable="false" text="Materia" />
            <TableColumn reorderable="false" text="Ore" />
        </columns>
    </TableView>


    <HBox alignment="CENTER_LEFT" prefHeight="28.0" prefWidth="512.0">
        <Label fx:id="profScelto" text="Scegli un professore" textFill="WHITE" />
        <Separator opacity="0.0" prefHeight="25.0" prefWidth="18.0" />
        <ComboBox fx:id="comboBoxDocenti" promptText="Professore" />
        <Separator opacity="0.0" prefHeight="13.0" prefWidth="34.0" />
        <Button onAction="#finestraVincoli" styleClass="modificavincoli-button" text="Modifica i vincoli" />
    </HBox>
</VBox>
